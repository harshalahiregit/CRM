{
    "name": "sangoe/sire",
    "description": "SIRE \u2014 a CRM-agnostic engineering issue and quality management module for compatible Laravel/PHP CRM systems.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "issue-tracking",
        "quality",
        "qa",
        "sla",
        "multi-tenant"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0",
        "illuminate/validation": "^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sire\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sire\\SireServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "laravel/framework": "SIRE installs into a Laravel application; illuminate/foundation (FormRequest, controller traits) comes with it."
    }
}
