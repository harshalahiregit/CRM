{
  "name": "northwind",
  "description": "Nothing conventional: organization_id, session auth, a Spatie roles table, Inertia. Every axis differs from acme.",
  "discovered": {
    "framework.version": "10.48.4",
    "php.version": "8.2.18",
    "database.driver": "mysql",
    "database.engine": "mariadb",
    "auth.guards": ["web"],
    "auth.packages": [],
    "user.model": "App\\Models\\User",
    "user.table": "users",
    "user.columns": ["id", "full_name", "email", "organization_id", "created_at"],
    "tenant.columns_present": ["organization_id"],
    "tenant.model": "App\\Models\\Organization",
    "roles.source": "roles.name",
    "roles.available": ["super_admin", "employee", "engineer", "supplier", "customer"],
    "permissions.provider": "spatie/laravel-permission",
    "frontend.packages": ["@inertiajs/react", "react", "vite"],
    "tables": ["users", "organizations", "roles", "permissions", "comments", "media"]
  },
  "expected": {
    "tenant.strategy": "user_attribute",
    "tenant.attribute": "organization_id",
    "host.auth_middleware": ["auth:web"],
    "login_types.admin": ["super_admin"],
    "login_types.internal_user": ["employee", "engineer"],
    "login_types.customer": ["customer"],
    "login_types.vendor": ["supplier"],
    "frontend.type": "inertia-react",
    "user.name_field": "full_name",
    "compatibility.blocked": false
  }
}
