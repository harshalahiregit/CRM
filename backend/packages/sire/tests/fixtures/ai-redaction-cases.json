{
  "_comment": [
    "EXECUTABLE SPECIFICATION for what SIRE sends to an AI provider.",
    "",
    "Run by tests/aiRedaction.test.mjs (JS reference) and",
    "backend/tests/Unit/Sire/SireAiRedactorTest.php (the implementation).",
    "",
    "This is the file to read when someone asks what leaves the building. Every",
    "case is a rule somebody will otherwise have to take on trust."
  ],

  "cases": [
    {
      "name": "only allowlisted fields survive",
      "capability": "severity_recommendation",
      "input": {
        "title": "Saving a lead fails",
        "description": "Spinner then nothing",
        "module": "sales",
        "assignee_id": 42,
        "estimated_cost": 12000,
        "internal_notes": "customer threatening to churn"
      },
      "expect": {
        "kept": ["title", "description", "module"],
        "dropped": ["assignee_id", "estimated_cost", "internal_notes"]
      }
    },
    {
      "name": "a forbidden key is refused even when it is on the allowlist",
      "capability": "classification",
      "allowlist_override": ["title", "auth_token", "description"],
      "input": { "title": "x", "auth_token": "abc123", "description": "y" },
      "expect": { "kept": ["title", "description"], "dropped": ["auth_token"], "drop_reason": { "auth_token": "forbidden_key" } }
    },
    {
      "name": "person-identifying keys are refused outright",
      "capability": "classification",
      "allowlist_override": ["title", "reporter_email", "assignee_name", "user_phone"],
      "input": { "title": "x", "reporter_email": "a@b.com", "assignee_name": "Priya", "user_phone": "555" },
      "expect": { "kept": ["title"], "drop_reason": { "reporter_email": "pii_key", "assignee_name": "pii_key", "user_phone": "pii_key" } }
    },
    {
      "name": "an email address inside an allowed value is scrubbed",
      "capability": "classification",
      "input": { "title": "Contact fails", "description": "Reported by someone@example.com after login" },
      "expect": { "value_contains_not": ["someone@example.com"], "value_contains": ["[redacted]"] }
    },
    {
      "name": "a bearer-looking token inside an allowed value is scrubbed",
      "capability": "classification",
      "input": { "title": "Auth", "description": "Header was Bearer Ab9xQ2Lm7Nb4Vc8Rt1Yu6Wq3Ee5Rr and it failed" },
      "expect": { "value_contains_not": ["Ab9xQ2Lm7Nb4Vc8Rt1Yu6Wq3Ee5Rr"] }
    },
    {
      "name": "a url query token inside an allowed value is scrubbed",
      "capability": "classification",
      "input": { "title": "Link", "description": "Opened https://app.sangoe.in/x?token=Zx9QpLm2Nb7Vc4Rt8Yu1Wq&tab=notes" },
      "expect": { "value_contains_not": ["Zx9QpLm2Nb7Vc4Rt8Yu1Wq"], "value_contains": ["tab=notes"] }
    },
    {
      "name": "long values are truncated rather than dropped",
      "capability": "classification",
      "input": { "title": "x", "description": "LONG:5000" },
      "expect": { "kept": ["title", "description"], "max_value_length": 4000, "truncated": ["description"] }
    },
    {
      "name": "nested objects are refused for a scalar field",
      "capability": "classification",
      "input": { "title": "x", "description": { "nested": "value" } },
      "expect": { "kept": ["title"], "drop_reason": { "description": "not_scalar" } }
    },
    {
      "name": "declared structured fields keep their shape but are still scrubbed",
      "capability": "engineering_insights",
      "input": {
        "reopen_rate": 0.25,
        "top_modules": [
          { "module": "sales", "total": 12, "owner_email": "lead@example.com" },
          { "module": "hr", "total": 4 }
        ]
      },
      "expect": {
        "kept": ["reopen_rate", "top_modules"],
        "structured_ok": true,
        "value_contains_not": ["lead@example.com"]
      }
    },
    {
      "name": "null and empty values are dropped, not sent as noise",
      "capability": "classification",
      "input": { "title": "x", "description": null, "module": "", "section": "   " },
      "expect": { "kept": ["title"] }
    },
    {
      "name": "an unknown capability sends nothing at all",
      "capability": "no_such_capability",
      "input": { "title": "x", "description": "y" },
      "expect": { "kept": [], "empty": true }
    },
    {
      "name": "tenant and identity fields never appear, whatever is passed",
      "capability": "classification",
      "allowlist_override": ["title", "tenant_id", "reporter_id", "user_id"],
      "input": { "title": "x", "tenant_id": 7, "reporter_id": 3, "user_id": 9 },
      "expect": { "kept": ["title"], "drop_reason": { "tenant_id": "identity_key", "reporter_id": "identity_key", "user_id": "identity_key" } }
    },
    {
      "name": "the field count is capped",
      "capability": "classification",
      "allowlist_override": "MANY:60",
      "input": "MANY:60",
      "expect": { "max_fields": 40 }
    },
    {
      "name": "booleans and numbers survive as themselves",
      "capability": "priority_recommendation",
      "input": { "title": "x", "is_regression": true, "reopen_count": 3, "occurrence_count": 0 },
      "expect": { "kept": ["title", "is_regression", "reopen_count", "occurrence_count"], "types": { "is_regression": "boolean", "reopen_count": "number", "occurrence_count": "number" } }
    }
  ]
}
