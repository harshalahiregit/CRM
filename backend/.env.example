APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# In dev the API and the SPA run on different origins. APP_URL is the API's own
# address (used for signed one-click email links + storage URLs); FRONTEND_URL is
# the React SPA (used for "Open ticket" deep links in email). Point them at the
# real dev ports so email links resolve — e.g. APP_URL=http://127.0.0.1:8000 and
# FRONTEND_URL=http://localhost:5173. In production with a single origin, set both
# to your domain.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Configuration (Twilio)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_REMINDERS_ENABLED=true
WHATSAPP_REMINDER_HOURS=24

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Helpdesk inbound email (provider route/webhook or IMAP poller). The webhook
# must POST with ?secret= / X-Inbound-Secret matching HELPDESK_INBOUND_SECRET.
HELPDESK_INBOUND_ADDRESS=support@your-domain.com
HELPDESK_INBOUND_SECRET=

# ── Online Meeting Integration ────────────────────────────────────────────────
# Set MEETING_PROVIDER to enable a live platform; leave as 'stub' for local dev.
# Stub returns a placeholder URL so the UI can be tested without API keys.
MEETING_PROVIDER=stub           # google_meet | zoom | teams | stub

# Google Meet (requires Google Calendar API service account)
GOOGLE_MEET_CREDENTIALS_JSON=   # Absolute path to service-account JSON key file
GOOGLE_MEET_CALENDAR_ID=primary # Calendar ID to create events in

# Zoom (Server-to-Server OAuth — replaces deprecated JWT app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Microsoft Teams (Microsoft Graph API — application permissions)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
