# Frontend environment — copy to .env (dev) or set in .env.production (build).
# All VITE_* values are compiled into the browser bundle, so they must be PUBLIC.

# API base. Same-origin default; the Laravel app serves /api and the SPA together.
VITE_API_URL=/api

# --- Cloud file import (Google Drive / OneDrive / pCloud pickers) ---
# Public client ids only — no secrets. Leave a value blank to disable that
# provider (its button shows "Not configured"). Changes require a rebuild.
# Used by the vendor Attachments area (TPV + Purchase) and the "Import from cloud"
# control in Tasks / Helpdesk / Projects / Inventory.

# Google Drive: OAuth 2.0 Web client id + an API key with the Picker API enabled.
# Register this site's origin under the OAuth client's "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# OneDrive: Azure app (application/client) id, OneDrive File Picker enabled, with
# this origin registered as a SPA redirect URI.
VITE_MS_CLIENT_ID=

# pCloud: pCloud app id (OAuth implicit flow), with <origin>/cloud-oauth.html
# registered as the redirect URI.
VITE_PCLOUD_CLIENT_ID=
