# Same-origin API. The Laravel app serves both /api and the React build, so a
# relative base works on any domain with no rebuild — and no CORS.
VITE_API_URL=/api

# Cloud file import — PUBLIC client ids for the in-app pickers (Google Drive /
# OneDrive / pCloud), used both by the vendor Attachments area and the "Import
# from cloud" control in Tasks/Helpdesk/Projects/Inventory. Safe to ship in the
# bundle. Leave blank to keep a provider disabled ("Not configured"); a rebuild is
# required after changing these.
#   Google  : OAuth 2.0 Web client id + a Picker-API key. Add this domain to the
#             OAuth client's "Authorized JavaScript origins".
#   OneDrive: Azure app (application/client) id, OneDrive File Picker enabled, with
#             this origin listed as a SPA redirect URI.
#   pCloud  : pCloud app id, with <origin>/cloud-oauth.html as the redirect URI.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_MS_CLIENT_ID=
VITE_PCLOUD_CLIENT_ID=
