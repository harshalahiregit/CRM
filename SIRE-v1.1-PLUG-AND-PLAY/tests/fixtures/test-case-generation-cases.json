{
  "_comment": [
    "EXECUTABLE SPECIFICATION for SIRE test case generation.",
    "Run by tests/testCaseGeneration.test.mjs and",
    "backend/tests/Unit/Sire/SireTestCaseGeneratorTest.php.",
    "",
    "Most cases assert WHICH categories are emitted, because that is where the",
    "value and the risk both sit. A boundary test on an issue with no boundaries is",
    "noise, and noise in a QA checklist trains people to skim it."
  ],
  "cases": [
    {
      "name": "a bare issue still gets the two tests every defect needs",
      "issue": { "title": "Something is broken", "module": "sales" },
      "expect": { "categories": ["happy_path", "failure_path"], "count": 2 }
    },
    {
      "name": "a numeric limit in the text produces a boundary case",
      "issue": { "title": "Notes over 5000 characters fail to save", "module": "sales", "screen": "lead-details" },
      "expect": { "includes": ["boundary"], "boundary_mentions": "5000" }
    },
    {
      "name": "http status codes are not mistaken for boundary values",
      "issue": { "title": "Save returns 500", "description": "the endpoint responds 500 not 200", "module": "sales" },
      "expect": { "excludes": ["boundary"] }
    },
    {
      "name": "boundary words alone are enough without a number",
      "issue": { "title": "Empty description crashes the form", "module": "sales" },
      "expect": { "includes": ["boundary"] }
    },
    {
      "name": "a permission word produces a permission case",
      "issue": { "title": "Staff get a 403 opening a lead", "module": "sales" },
      "expect": { "includes": ["permission"] }
    },
    {
      "name": "an issue about a specific record produces a permission case even with no keyword",
      "issue": { "title": "Total is wrong", "module": "sales", "entity_type": "lead" },
      "expect": { "includes": ["permission"], "permission_rationale_mentions": "lead" }
    },
    {
      "name": "an issue with neither signal gets no permission case",
      "issue": { "title": "Column header is misaligned", "module": "sales" },
      "expect": { "excludes": ["permission"] }
    },
    {
      "name": "a regression flag produces a regression case",
      "issue": { "title": "Lead save fails again", "module": "sales", "is_regression": true },
      "expect": { "includes": ["regression"], "regression_rationale_mentions": "regression" }
    },
    {
      "name": "a reopened issue produces a regression case and says how many times",
      "issue": { "title": "Lead save fails", "module": "sales", "reopen_count": 3 },
      "expect": { "includes": ["regression"], "regression_rationale_mentions": "3" }
    },
    {
      "name": "a first-time issue with no fix version gets no regression case",
      "issue": { "title": "Column header is misaligned", "module": "sales", "is_regression": false, "reopen_count": 0 },
      "expect": { "excludes": ["regression"] }
    },
    {
      "name": "linked issues produce a related-workflow case naming them",
      "issue": { "title": "Lead save fails", "module": "sales" },
      "opts": { "relatedRefs": ["SIR-00088", "SIR-00091"] },
      "expect": { "includes": ["related_workflow"], "related_mentions": "SIR-00088" }
    },
    {
      "name": "a section alone is enough for a related-workflow case",
      "issue": { "title": "Lead save fails", "module": "sales", "section": "leads" },
      "expect": { "includes": ["related_workflow"] }
    },
    {
      "name": "an issue with everything produces all six categories",
      "issue": {
        "title": "Staff get a 403 saving notes over 5000 characters",
        "description": "Regression from last release",
        "steps_to_reproduce": "Open a lead, paste a long note, press Save",
        "expected_result": "The note saves",
        "actual_result": "A 403 is returned",
        "module": "sales", "section": "leads", "screen": "lead-details",
        "entity_type": "lead", "is_regression": true, "reopen_count": 1,
        "fixed_version": "2026.4"
      },
      "opts": { "relatedRefs": ["SIR-00088"], "regressionOf": "SIR-00042" },
      "expect": {
        "categories": ["happy_path", "failure_path", "boundary", "permission", "regression", "related_workflow"],
        "count": 6,
        "regression_title_mentions": "SIR-00042"
      }
    }
  ]
}
